{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "generate:icons": "node scripts/generate-pwa-icons.js",
    "export:zip": "python3 scripts/export-zip.py public/capp-ai-project.zip && cp public/capp-ai-project.zip dist/ 2>/dev/null || true",
    "push:github": "bash scripts/push-to-github.sh",
    "build": "node scripts/generate-pwa-icons.js && python3 scripts/export-zip.py public/capp-ai-project.zip && vite build && mkdir -p build/web && cp -r dist/* build/web/ && cp public/capp-ai-project.zip build/web/ && cp public/capp-ai-project.zip dist/",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
